#!/bin/bash
set -e

APP="/Applications/GorizontVS-VDI.app"
SPICE="$APP/Contents/Resources/spice"
SPICY_BIN="$SPICE/bin/spicy"

WRAPPER="/usr/local/bin/spicy"
SUDOERS_FILE="/etc/sudoers.d/gorizontvs-spicy"

if [ ! -d "$APP" ]; then
  exit 0
fi

if [ ! -x "$SPICY_BIN" ]; then
  echo "postinstall: bundled spicy not found or not executable: $SPICY_BIN"
  exit 0
fi

echo "postinstall: install /usr/local/bin/spicy wrapper"

mkdir -p /usr/local/bin

cat > "$WRAPPER" <<'EOF'
#!/bin/bash
set -e

APP="/Applications/GorizontVS-VDI.app"
SPICE="$APP/Contents/Resources/spice"
SPICY_BIN="$SPICE/bin/spicy"

if [ ! -x "$SPICY_BIN" ]; then
  echo "ERROR: bundled spicy not found: $SPICY_BIN" >&2
  exit 127
fi

USER_HOME="${HOME:-/tmp}"
APP_SUPPORT="$USER_HOME/Library/Application Support/GorizontVS"

mkdir -p "$APP_SUPPORT" || true

export PATH="$SPICE/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# В нормальном bundle dylib должны быть переписаны через @rpath/@loader_path.
# DYLD_* может чиститься macOS/sudo, поэтому не делаем на него единственную ставку.
export DYLD_FALLBACK_LIBRARY_PATH="$APP/Contents/Frameworks:$SPICE/lib:$SPICE/lib/gstreamer-1.0:/usr/lib"

export GST_PLUGIN_PATH_1_0="$SPICE/lib/gstreamer-1.0"
export GST_PLUGIN_SCANNER="$SPICE/libexec/gstreamer-1.0/gst-plugin-scanner"
export GST_REGISTRY_REUSE_PLUGIN_SCANNER=1
export GST_REGISTRY="$APP_SUPPORT/gstreamer-registry.bin"

export GIO_MODULE_DIR="$SPICE/lib/gio/modules"
export GI_TYPELIB_PATH="$SPICE/lib/girepository-1.0"

export GDK_PIXBUF_MODULEDIR="$SPICE/lib/gdk-pixbuf-2.0/2.10.0/loaders"
export GDK_PIXBUF_MODULE_FILE="$SPICE/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache"

export XDG_DATA_DIRS="$SPICE/share:/usr/local/share:/usr/share"
export GTK_DATA_PREFIX="$SPICE"
export GTK_EXE_PREFIX="$SPICE"
export GTK_PATH="$SPICE"

export TEXTDOMAINDIR="$SPICE/share/locale"
export USB_IDS_PATH="$SPICE/share/hwdata/usb.ids"

export LANG="${LANG:-ru_RU.UTF-8}"
export LC_MESSAGES="${LC_MESSAGES:-ru_RU.UTF-8}"
export LANGUAGE="${LANGUAGE:-ru}"

# На macOS USB redirect через libusb часто требует root для claim interface.
# sudo -n не спрашивает пароль: либо sudoers разрешил, либо сразу ошибка.
exec /usr/bin/sudo -n -E "$SPICY_BIN" "$@"
EOF

chown root:wheel "$WRAPPER"
chmod 755 "$WRAPPER"

echo "postinstall: install sudoers rule for bundled spicy"

cat > "$SUDOERS_FILE" <<EOF
# GorizontVS-VDI: allow admin users to run bundled spicy as root without password.
# Needed on macOS for libusb USB redirection claim interface.

Defaults env_keep += "LANG LC_ALL LC_MESSAGES LANGUAGE"
Defaults env_keep += "PATH"
Defaults env_keep += "GST_PLUGIN_PATH_1_0 GST_PLUGIN_SCANNER GST_REGISTRY_REUSE_PLUGIN_SCANNER GST_REGISTRY"
Defaults env_keep += "GIO_MODULE_DIR GI_TYPELIB_PATH"
Defaults env_keep += "GDK_PIXBUF_MODULEDIR GDK_PIXBUF_MODULE_FILE"
Defaults env_keep += "XDG_DATA_DIRS GTK_DATA_PREFIX GTK_EXE_PREFIX GTK_PATH"
Defaults env_keep += "TEXTDOMAINDIR USB_IDS_PATH"
Defaults env_keep += "DYLD_FALLBACK_LIBRARY_PATH"

%admin ALL=(root) NOPASSWD: SETENV: $SPICY_BIN
EOF

chown root:wheel "$SUDOERS_FILE"
chmod 440 "$SUDOERS_FILE"

if ! /usr/sbin/visudo -c -f "$SUDOERS_FILE"; then
  echo "postinstall: sudoers validation failed, removing $SUDOERS_FILE"
  rm -f "$SUDOERS_FILE"
  exit 1
fi

echo "postinstall: done"

exit 0
